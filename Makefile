# @keenmate/base-css-variables - Makefile
# Ship the canonical --base-* CSS custom-property contract.
#
# This package has NO build step: base-variables.css is authored by hand and IS
# the published artifact (no SCSS, no compile, no dist/). The targets below wrap
# npm's pack/publish so releases match pure-css's ergonomics, plus the repo-only
# examples site + e2e suite (examples-*.html, e2e/ — never shipped).
#
# Usage:
#   make setup          Install dev deps + Playwright browsers, build the examples' components
#   make install        Install dev dependencies (Playwright)
#   make build          Build the SIBLING components the examples load (../web-treeview,
#                       ../web-multiselect) — this package itself has nothing to build
#   make dev            Serve the examples on http://localhost:15300 (devkit Vite preset)
#   make kill-port      Free the dev / preview ports (15300, 15301) held by a stale server
#   make build-examples Build the static examples site (dist-examples/)
#   make preview-examples Serve the built examples site on http://localhost:15301
#   make image-build    Build the examples container image (Dockerfile from `kmwc sync`)
#   make image-run      Run it on http://localhost:15310 (image-stop / image-clean)
#   make test           Run the e2e suite (headless)
#   make test-headed    Run the e2e suite in a visible browser
#   make sizes          Show the size of base-variables.css
#   make package        Create npm tarball
#   make verify         Create tarball and confirm contents
#   make publish-dry    Dry-run publish as 'latest' (verify what would be published)
#   make publish-dry-rc Dry-run publish under --tag rc (for pre-releases)
#   make publish        Publish to npm as 'latest'
#   make publish-rc     Publish under --tag rc (canonical for X.Y.Z-rcN)
#   make publish TAG=<x> Publish under arbitrary dist-tag (e.g. TAG=beta, TAG=next)

# --- Windows recipe-shell fix -------------------------------------------------
# GNU make on Windows picks Git's bare `usr/bin/sh.exe` as the recipe shell,
# which breaks npm/npx's Unix shell-shims. Pin the recipe shell to Git's full
# bash launcher so `env bash` resolves to MSYS bash. Guarded so it's a no-op
# when Git isn't at the default location. (Mirrors pure-css.)
ifeq ($(OS),Windows_NT)
  ifneq ($(wildcard C:/Program?Files/Git/bin/bash.exe),)
    SHELL := C:/Program Files/Git/bin/bash.exe
  endif
endif
# -----------------------------------------------------------------------------

# Sibling component repos the examples + e2e load from (override if checked out elsewhere,
# e.g. `make build WEB_TREEVIEW_DIR=/src/web-treeview`). vite.config.ts reads the same
# locations via WEB_TREEVIEW_DIST / WEB_MULTISELECT_DIST, exported below.
WEB_TREEVIEW_DIR ?= ../web-treeview
WEB_MULTISELECT_DIR ?= ../web-multiselect
export WEB_TREEVIEW_DIST = $(WEB_TREEVIEW_DIR)/dist
export WEB_MULTISELECT_DIST = $(WEB_MULTISELECT_DIR)/dist

# Examples dev / preview ports (package.json#kmwc.ports: dev = block, preview = +1)
DEV_PORT ?= 15300
PREVIEW_PORT ?= 15301

# Examples container image (Dockerfile / nginx.conf / .dockerignore are generated by
# `npx kmwc sync` from package.json#kmwc). Per-developer overrides (e.g. DOCKER_RUNNER =
# docker) go in .makefile.env — not committed.
-include .makefile.env
DOCKER_RUNNER  ?= podman
IMAGE_NAME     ?= registry.km8.es/base-css-variables-examples:prod
CONTAINER_NAME ?= base-css-variables-examples
IMAGE_PORT     ?= 15310

# NPM publish tag (empty for latest, use TAG=rc for pre-releases)
TAG ?=
NPM_TAG = $(if $(TAG),--tag $(TAG),)

.PHONY: help setup install build dev kill-port build-examples preview-examples image-build image-run image-stop image-clean test test-headed sizes package verify publish-dry publish-dry-rc publish publish-rc

help:
	@echo "@keenmate/base-css-variables - Available Commands:"
	@echo ""
	@echo "  (no build — base-variables.css is authored directly and shipped as-is)"
	@echo ""
	@echo "  Demo / e2e (repo-only, never shipped):"
	@echo "    make setup          - Install dev deps + browsers, build the examples' components"
	@echo "    make install        - Install dev dependencies (Playwright)"
	@echo "    make build          - Build ../web-treeview + ../web-multiselect for the examples"
	@echo "    make dev            - Serve the examples on http://localhost:15300"
	@echo "    make kill-port      - Free the dev / preview ports (15300, 15301)"
	@echo "    make build-examples - Build the static examples site (dist-examples/)"
	@echo "    make preview-examples - Serve the built site on http://localhost:15301"
	@echo "    make test           - Run the e2e suite (headless)"
	@echo "    make test-headed    - Run the e2e suite in a visible browser"
	@echo ""
	@echo "  Package:"
	@echo "    make sizes          - Show base-variables.css size"
	@echo "    make package        - Create npm tarball"
	@echo "    make verify         - Create tarball and confirm contents"
	@echo "    make publish-dry    - Dry-run publish as 'latest'"
	@echo "    make publish-dry-rc - Dry-run publish under --tag rc"
	@echo "    make publish        - Publish to npm as 'latest'"
	@echo "    make publish-rc     - Publish under --tag rc (canonical for X.Y.Z-rcN)"
	@echo "    make publish TAG=x  - Publish under arbitrary dist-tag"
	@echo ""
	@echo "  Examples image ($(DOCKER_RUNNER)):"
	@echo "    make image-build    - Build $(IMAGE_NAME)"
	@echo "    make image-run      - Run it on http://localhost:$(IMAGE_PORT)"
	@echo "    make image-stop     - Stop and remove the container"
	@echo "    make image-clean    - Remove the container and the image"
	@echo ""

setup: install build
	npm run test:e2e:install

install:
	npm install

# The examples load the LOCAL builds of the sibling components, so they must be
# rebuilt to pick up token renames on their side. dist/ is gitignored in both.
build:
	cd "$(WEB_TREEVIEW_DIR)" && npm run build
	cd "$(WEB_MULTISELECT_DIR)" && npm run build

dev:
	npm run dev

# Free the dev + preview ports. Vite runs with strictPort, so a stale server is
# the only thing that can hold them. On Windows a PowerShell one-liner covers
# IPv4 + IPv6 listeners; `$$_` escapes make's `$` and the single quotes stop sh
# from expanding `$_` before PowerShell sees it. (Same recipe as the devkit's
# Makefile template.)
kill-port:
ifeq ($(OS),Windows_NT)
	-@powershell -NoProfile -Command '$(DEV_PORT),$(PREVIEW_PORT) | ForEach-Object { Get-NetTCPConnection -LocalPort $$_ -State Listen -ErrorAction SilentlyContinue } | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $$_ -Force -ErrorAction SilentlyContinue }'
else
	-@for p in $(DEV_PORT) $(PREVIEW_PORT); do lsof -ti tcp:$$p | xargs -r kill -9; done
endif
	@echo "Ports $(DEV_PORT), $(PREVIEW_PORT) are free"

test:
	npm run test:e2e

test-headed:
	npm run test:e2e:headed

build-examples:
	npm run build:examples

preview-examples: build-examples
	npm run preview:examples

# ── Container image (examples site) — same recipes as the devkit's Makefile template ──

image-build:
	$(DOCKER_RUNNER) build --build-arg BUILD_TIME=$$(date -u +%Y-%m-%dT%H:%MZ) -t $(IMAGE_NAME) .

image-run:
	-@$(DOCKER_RUNNER) rm -f $(CONTAINER_NAME) >/dev/null 2>&1
	$(DOCKER_RUNNER) run -d --name $(CONTAINER_NAME) -p $(IMAGE_PORT):80 $(IMAGE_NAME)
	@echo "Serving examples at http://localhost:$(IMAGE_PORT)"

image-stop:
	-@$(DOCKER_RUNNER) rm -f $(CONTAINER_NAME) >/dev/null 2>&1

image-clean: image-stop
	-@$(DOCKER_RUNNER) rmi $(IMAGE_NAME) >/dev/null 2>&1

sizes:
	@ls -l base-variables.css | awk '{printf "  %8d  %s\n", $$5, $$9}'

# Create package tarball
package:
	npm pack

# Verify what would be published
verify:
	npm pack --dry-run
	@echo "Package verified and ready!"

# Dry-run publish as 'latest' (verify what would be published)
publish-dry:
	npm publish --dry-run $(NPM_TAG)

# Dry-run publish under --tag rc (for pre-release versions like X.Y.Z-rcN)
publish-dry-rc:
	npm publish --dry-run --tag rc

# Publish to npm as 'latest'
publish:
	npm publish $(NPM_TAG)

# Publish under --tag rc (canonical for X.Y.Z-rcN pre-releases). Keeps the
# 'latest' dist-tag untouched; consumers opt in via @rc or by pinning the exact
# version. Equivalent to `make publish TAG=rc` but harder to forget.
publish-rc:
	npm publish --tag rc
