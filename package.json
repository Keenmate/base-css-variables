{
  "name": "@keenmate/base-css-variables",
  "version": "2.0.0-rc07",
  "description": "Shared base layer of CSS custom properties (--base-*) for Keenmate web components",
  "license": "MIT",
  "author": "Keenmate s.r.o.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenmate/base-css-variables.git"
  },
  "keywords": [
    "css-variables",
    "custom-properties",
    "theme",
    "design-tokens",
    "keenmate"
  ],
  "type": "module",
  "style": "./base-variables.css",
  "bin": {
    "base-contract-check": "bin/check-contract.mjs"
  },
  "exports": {
    ".": "./base-variables.css",
    "./base-variables.css": "./base-variables.css",
    "./check": "./bin/check-contract.mjs",
    "./renames.json": "./renames.json",
    "./testing/parity": "./testing/parity.mjs"
  },
  "files": [
    "base-variables.css",
    "bin/check-contract.mjs",
    "renames.json",
    "testing/parity.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build:examples": "vite build --mode examples",
    "preview:examples": "vite preview --mode examples",
    "test": "npm run test:check && npm run test:e2e",
    "test:check": "node --test test/check-contract.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "clean": "node -e \"for (const p of ['dist','dist-examples']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@keenmate/web-components-devkit": "file:../web-components",
    "vite": "^7.3.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "kmwc": {
    "title": "Base CSS Variables",
    "tagline": "The shared --base-* token contract behind pure-admin and every Keenmate web component.",
    "ports": {
      "dev": 15300,
      "image": 15310
    },
    "examples": {
      "staticPaths": [
        "base-variables.css"
      ]
    },
    "analytics": {
      "plausibleSiteId": "pa-6G7AjoFhN9izTmJPF5mFl"
    },
    "sync": {
      "skippedFiles": [
        "Makefile",
        "CLAUDE.md"
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
