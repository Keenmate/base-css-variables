    { "from": "--base-<role>-bg-light", "to": "--base-<role>-bg-subtle", "since": "2.0.0" },
    { "from": "--base-<role>-bg", "to": "--base-<role>-color", "since": "2.0.0", "note": "was a pasted copy of -color" },
    { "from": "--base-<role>-text-light", "to": null, "since": "2.0.0", "note": "removed (unused)" },
    { "from": "--base-<role>-border", "to": null, "since": "2.0.0", "note": "removed (unused) — use a component border token" },
    { "from": "--base-color-N", "to": "--base-palette-N", "since": "2.0.0" },
    { "from": "--base-color-N-text", "to": "--base-on-palette-N-text-color", "since": "2.0.0" },
    { "from": "--base-input-color", "to": "--base-input-text-color", "since": "2.0.0" },
