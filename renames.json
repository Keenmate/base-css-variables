    { "from": "--base-input-clear-bg-hover", "to": "--base-input-icon-bg-hover", "since": "2.0.0" },
    { "from": "--base-tooltip-color", "to": "--base-tooltip-text-color", "since": "2.0.0" },
    { "from": "--base-inverse-bg", "to": "--base-tooltip-bg", "since": "2.0.0", "note": "removed; the tooltip has its own pair" },
    { "from": "--base-inverse-text-color", "to": "--base-tooltip-text-color", "since": "2.0.0", "note": "removed; the tooltip has its own pair" },
    { "from": "--base-text-inverted", "to": "--base-tooltip-text-color", "since": "2.0.0", "note": "removed; the tooltip has its own pair" }
